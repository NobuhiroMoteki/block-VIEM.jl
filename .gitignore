# Julia build/cache artifacts
*.jl.cov
*.jl.*.cov
*.jl.mem
/deps/deps.jl
/deps/build.log

# Note: Manifest.toml is intentionally tracked for reproducibility.

# Documentation build artifacts
/docs/build/
/docs/site/

# LaTeX build artifacts
*.aux
*.log
*.fls
*.fdb_latexmk
*.synctex.gz
*.out
*.toc
*.bbl
*.blg
*.nav
*.snm
*.vrb

# OS / editor
*:Zone.Identifier
.DS_Store
*.swp
*~
.vscode/
.idea/

# Mesh artifacts (regenerable from .geo)
*.msh
!test/meshes/reference/*.msh

# External benchmark tools (buff-em, scuff-em, OpenBLAS, etc.)
# These are large (~500MB) and rebuildable via benchmarks/external/README.md
/benchmarks/external/buff-em/
/benchmarks/external/scuff-em/
/benchmarks/external/opt/

# Benchmark run outputs (regenerable)
/benchmarks/runs/*.PFT
/benchmarks/runs/*.log
/benchmarks/runs/*.buffgeo
# FIBBI cache files are large (~14 MB each) and take ~10 min to compute,
# but are mesh-dependent and can be regenerated — gitignore them.
/benchmarks/runs/*.cache
!/benchmarks/runs/.gitkeep
# Keep omega files (small, describe the test conditions)
!/benchmarks/runs/omega_*.txt

# Claude Code / Gemini AI workspace: technical notes, RAG references,
# per-project agent settings, scratchpads.  Kept locally only; never
# published to the public repository.
/.claude/

# backup checkpoints (kept locally, not versioned)
*.bak_L1
